# ==============================================================================
# Humsafar Rishta Center - Environment Configuration Template (.env.example)
# Copy this file to .env and configure real production values before deployment.
# NEVER commit the real .env file or credentials to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Vite / React / Capacitor)
# ------------------------------------------------------------------------------
# Production backend API URL (MUST use HTTPS with a valid domain, NO localhost)
# Example: https://api.humsafarrishta.com
VITE_API_BASE_URL=https://api.humsafarrishta.com

# Official WhatsApp Business contact number in international format without leading +
# Example: 923251013131
VITE_WHATSAPP_NUMBER=923251013131

# Official App Support Email
VITE_SUPPORT_EMAIL=support@humsafarrishta.com

# Google OAuth 2.0 Web Client ID (from Google Cloud Console / Firebase)
# Used for verified Google Sign-In
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 2. BACKEND API SERVER CONFIGURATION (Node.js / Express)
# ------------------------------------------------------------------------------
# Port for the Node.js API server
PORT=5000

# Node Environment ('production' or 'development')
NODE_ENV=production

# Strong random secret string for JWT token signing (min 64 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_KEY

# Bcrypt hash of Master Admin Password (NEVER store plaintext password!)
# To generate a new hash: node -e "console.log(require('bcryptjs').hashSync('YOUR_NEW_SECURE_PASSWORD', 12))"
ADMIN_PASSWORD_HASH=$2b$12$e8Zz2g.ExampleHashedAdminPasswordStringForProductionOnly

# Allowed CORS Origins (comma-separated list of allowed web origins)
# For Capacitor native apps: capacitor://localhost, http://localhost, https://localhost
ALLOWED_ORIGINS=https://humsafarrishta.com,https://ranaadkhan.github.io,capacitor://localhost,http://localhost

# Google OAuth Client ID for server-side token validation
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 3. ANDROID RELEASE SIGNING CONFIGURATION (Gradle)
# ------------------------------------------------------------------------------
# Path to your private release keystore file
# KEYSTORE_FILE=C:/keys/humsafar-release.keystore
# KEYSTORE_PASSWORD=YOUR_STRONG_KEYSTORE_PASSWORD
# KEY_ALIAS=humsafar_release_key
# KEY_PASSWORD=YOUR_STRONG_KEY_PASSWORD
